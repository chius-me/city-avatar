{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "city-avatar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "STYLE_BURST_LIMITER",
      "namespace_id": "202601",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA_GUARD",
        "class_name": "QuotaGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuotaGuard"]
    }
  ],
  "vars": {
    "GENERATION_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://avatar.city.chius.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGJ2h2mDvXum_LZS",
    "TURNSTILE_HOSTNAMES": "avatar.city.chius.dev",
    "DAILY_IP_CREDITS": "12",
    "DAILY_GLOBAL_NEURON_BUDGET": "8500"
  },
  "routes": [
    {
      "pattern": "avatar.city.chius.dev",
      "custom_domain": true
    }
  ]
}
